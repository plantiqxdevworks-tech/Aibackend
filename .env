FLASK_ENV=development
FLASK_PORT=5005

# ─── AI provider ──────────────────────────────────────────────
# Provider is auto-detected from the API key prefix:
#   sk-      -> openai
#   gsk_     -> groq
#   sk-or-   -> openrouter
#   tgp_     -> together
# Override detection with AI_PROVIDER / AI_BASE_URL if needed.
#
# AI_MODEL must be valid for the detected provider. For Groq, good options:
#   llama-3.3-70b-versatile   (best quality, default)
#   llama-3.1-8b-instant      (fastest, cheapest)
AI_MODEL=llama-3.3-70b-versatile

# API key (Groq key detected). Also accepts AI_API_KEY / GROQ_API_KEY.
OPENAI_API_KEY=your_groq_api_key_here
