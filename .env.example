FLASK_ENV=development
FLASK_PORT=5005

# ─── AI provider ──────────────────────────────────────────────
# The provider is auto-detected from the API-key prefix:
#   sk-     -> openai     (model e.g. gpt-4o-mini)
#   gsk_    -> groq       (model e.g. llama-3.3-70b-versatile)
#   sk-or-  -> openrouter (model e.g. openai/gpt-4o-mini)
#   tgp_    -> together   (model e.g. meta-llama/Llama-3.3-70B-Instruct-Turbo)
#
# Optional overrides:
#   AI_PROVIDER  -> force provider id (openai|groq|openrouter|together)
#   AI_BASE_URL  -> force a custom OpenAI-compatible base URL
#
# AI_MODEL must be valid for the resolved provider. A gpt-* model on a
# non-OpenAI provider is automatically replaced with that provider's default.
AI_MODEL=llama-3.3-70b-versatile

# API key. OPENAI_API_KEY is the primary name; AI_API_KEY / GROQ_API_KEY
# are also accepted. Leave empty to run in local-heuristic fallback mode.
OPENAI_API_KEY=
